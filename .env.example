# NVIDIA API Key (Llama / Nemotron)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Maps API Key (Places & Geolocation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_super_secret_key_here

# Database
DATABASE_URI=sqlite:///database/healthbot.db
